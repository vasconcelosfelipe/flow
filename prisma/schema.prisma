// Flow — schema Prisma
// Regras de ouro:
//   • Valores monetários em centavos (Int), nunca Decimal ou Float
//   • Toda entidade operacional leva empresaId — isolamento por tenant
//   • Datas sem hora usam @db.Date; com hora, DateTime (UTC)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// AUTENTICAÇÃO — modelos no formato que o Better Auth exige
// Nomes em inglês são obrigatórios para o adapter funcionar.
// Campos customizados do domínio entram como additionalFields.
// ─────────────────────────────────────────────────────────────

model user {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  // campos extras do domínio Flow
  adminPlataforma  Boolean  @default(false)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions         session[]
  accounts         account[]
  membros          MembroEmpresa[]
  convitesEnviados Convite[]        @relation("ConviteRemetente")
}

model session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Credenciais OAuth e email/senha gerenciados pelo Better Auth
model account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([accountId, providerId])
}

// Tokens de verificação de e-mail e reset de senha
model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─────────────────────────────────────────────────────────────
// EMPRESA E MEMBROS
// ─────────────────────────────────────────────────────────────

model Empresa {
  id           String   @id @default(cuid())
  nome         String
  slug         String   @unique
  cnpj         String?  @unique
  ativa        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  membros        MembroEmpresa[]
  convites       Convite[]
  contas         Conta[]
  categorias     Categoria[]
  contatos       Contato[]
  centrosCusto   CentroCusto[]
  movimentacoes  Movimentacao[]
  recorrencias   Regra[]

  @@map("empresas")
}

model MembroEmpresa {
  id         String       @id @default(cuid())
  empresaId  String
  userId     String
  papel      PapelMembro
  criadoEm  DateTime     @default(now())

  empresa    Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario    user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId])
  @@index([userId])
  @@map("membros_empresa")
}

// Convite por e-mail — válido por 7 dias
model Convite {
  id          String      @id @default(cuid())
  empresaId   String
  // E-mail de quem ainda NÃO tem conta — de propósito sem FK pra `user.email`
  // (já existiu uma, e quebrava exatamente o caso de uso do convite: criar
  // convite pra alguém que ainda não existe como usuário).
  email       String
  papel       PapelMembro
  token       String      @unique @default(cuid())
  remetenteId String
  aceitoEm   DateTime?
  expiraEm   DateTime
  criadoEm   DateTime    @default(now())

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  remetente   user        @relation("ConviteRemetente", fields: [remetenteId], references: [id])

  @@index([empresaId])
  @@map("convites")
}

// ─────────────────────────────────────────────────────────────
// PLANO DE CONTAS
// ─────────────────────────────────────────────────────────────

model Conta {
  id           String    @id @default(cuid())
  empresaId    String
  nome         String
  tipo         TipoConta
  cor          String    @default("#2563EB")
  // Saldo inicial importado; movimentações recalculam o saldo real
  saldoInicial Int       @default(0)
  ativa        Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentacoes  Movimentacao[]

  @@index([empresaId])
  @@map("contas")
}

model Categoria {
  id          String        @id @default(cuid())
  empresaId   String
  nome        String
  icone       String        @default("outro")
  cor         String        @default("#64748B")
  tipo        TipoMovimentacao
  // Linha fixa da DRE onde esta categoria soma — a tela de Categorias é a
  // única responsável por essa configuração; a DRE nunca decide isso sozinha,
  // só consulta.
  linhaDreId  String?
  // Só um nível: uma subcategoria nunca tem suas próprias subcategorias — a
  // tela de Categorias só oferece categorias de topo como opção de pai.
  categoriaPaiId String?
  ativa       Boolean       @default(true)
  criadoEm   DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  linhaDre      LinhaDre?      @relation(fields: [linhaDreId], references: [id])
  categoriaPai  Categoria?     @relation("Subcategorias", fields: [categoriaPaiId], references: [id])
  subcategorias Categoria[]    @relation("Subcategorias")
  movimentacoes Movimentacao[]

  @@index([empresaId])
  @@index([categoriaPaiId])
  @@map("categorias")
}

// As linhas fixas da DRE gerencial — cadastro de referência, não por
// empresa. Cada categoria aponta para uma delas; a DRE soma as movimentações
// de cada categoria dentro da linha para a qual ela aponta. Nenhuma lista de
// categorias fica hardcoded no código: quem decide a composição de cada
// linha é o cadastro de Categorias, não o serviço de DRE.
model LinhaDre {
  id            String            @id
  nome          String
  ordem         Int
  // `null` = aceita categoria de receita e de despesa (só a linha "Outras
  // Receitas/Despesas" mistura os dois tipos por natureza).
  tipoPermitido TipoMovimentacao?

  categorias    Categoria[]

  @@map("linhas_dre")
}

model Contato {
  id         String      @id @default(cuid())
  empresaId  String
  nome       String
  // Vestigial: cadastro não distingue mais cliente/fornecedor (todo
  // registro serve pros dois papéis) — coluna mantida com default só pra
  // não exigir migração destrutiva em dado de produção já existente.
  tipo       TipoContato @default(AMBOS)
  documento  String?     // CPF ou CNPJ, sem formatação
  email      String?
  telefone   String?
  observacao String?
  ativo      Boolean     @default(true)
  criadoEm  DateTime    @default(now())
  atualizadoEm DateTime  @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentacoes Movimentacao[]

  @@index([empresaId])
  @@map("contatos")
}

model CentroCusto {
  id         String   @id @default(cuid())
  empresaId  String
  nome       String
  cor        String   @default("#64748B")
  ativo      Boolean  @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentacoes Movimentacao[]

  @@index([empresaId])
  @@map("centros_custo")
}

// ─────────────────────────────────────────────────────────────
// MOVIMENTAÇÕES
// ─────────────────────────────────────────────────────────────

model Movimentacao {
  id              String            @id @default(cuid())
  empresaId       String
  contaId         String
  categoriaId     String?
  contatoId       String?
  centroCustoId   String?
  regraId         String?           // origem, se veio de recorrência

  descricao       String
  tipo            TipoMovimentacao
  valorCentavos   Int               // sempre positivo; tipo define o sinal
  status          StatusMovimentacao
  formaPagamento  FormaPagamento?

  // data = data de caixa (quando o dinheiro entrou/saiu); null = ainda não ocorreu
  data            DateTime?         @db.Date
  dataVencimento  DateTime?         @db.Date
  // dataCompetencia = período contábil ao qual a despesa/receita pertence
  dataCompetencia DateTime          @db.Date

  // Parcelamento: numeroParcela/totalParcelas são preenchidos juntos ou nenhum
  numeroParcela   Int?
  totalParcelas   Int?
  // grupoParcelamento agrupa as N parcelas de uma compra parcelada
  grupoParcelamento String?

  descricaoOriginal String?         // texto original antes de edição
  observacao      String?
  recorrente      Boolean           @default(false)
  // FITID do OFX de origem — chave de deduplicação: reimportar o mesmo
  // extrato não cria lançamento duplicado. `null` para lançamentos manuais.
  origemFitId     String?
  // Transferência entre contas próprias vira DUAS movimentações (uma DESPESA
  // na conta de origem, uma RECEITA na de destino) compartilhando este id —
  // é o que liga o par pra excluir/exibir junto. `null` = lançamento comum.
  // Sem categoria nem contato de propósito: transferência não é receita nem
  // despesa de verdade, e já fica fora da DRE por não ter linhaDreId.
  transferenciaId String?

  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt

  empresa        Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conta          Conta        @relation(fields: [contaId], references: [id])
  categoria      Categoria?   @relation(fields: [categoriaId], references: [id])
  contato        Contato?     @relation(fields: [contatoId], references: [id])
  centroCusto    CentroCusto? @relation(fields: [centroCustoId], references: [id])
  regra          Regra?       @relation(fields: [regraId], references: [id])
  importacoes    ImportacaoLinha[]

  @@unique([contaId, origemFitId])
  @@index([transferenciaId])
  @@index([empresaId, data])
  @@index([empresaId, dataVencimento])
  @@index([empresaId, dataCompetencia])
  @@index([empresaId, categoriaId])
  @@index([empresaId, contaId])
  @@map("movimentacoes")
}

// ─────────────────────────────────────────────────────────────
// RECORRÊNCIAS
// ─────────────────────────────────────────────────────────────

// Uma regra gera lançamentos previstas automaticamente
model Regra {
  id              String            @id @default(cuid())
  empresaId       String
  contaId         String?
  categoriaId     String?
  contatoId       String?

  descricao       String
  tipo            TipoMovimentacao
  valorCentavos   Int
  frequencia      FrequenciaRegra
  // Dia do mês (1-28) ou dia da semana (0=dom) dependendo da frequência
  dia             Int?
  proximaOcorrencia DateTime        @db.Date
  ativa           Boolean           @default(true)
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt

  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentacoes   Movimentacao[]

  @@index([empresaId])
  @@map("regras")
}

// ─────────────────────────────────────────────────────────────
// IMPORTAÇÃO DE EXTRATO
// ─────────────────────────────────────────────────────────────

model Importacao {
  id          String   @id @default(cuid())
  empresaId   String
  nomeArquivo String
  formato     String   // "OFX" | "CSV" | "XLSX"
  totalLinhas Int
  criadoEm   DateTime @default(now())

  linhas      ImportacaoLinha[]

  @@index([empresaId])
  @@map("importacoes")
}

model ImportacaoLinha {
  id              String  @id @default(cuid())
  importacaoId    String
  movimentacaoId  String?
  // Presentes só quando a pessoa marcou "ignorar permanentemente" na revisão:
  // a linha do extrato foi descartada de propósito, sem virar lançamento —
  // contaId + fitId é a chave que impede essa mesma linha de ser sugerida de
  // novo numa reimportação futura do mesmo arquivo.
  contaId         String?
  fitId           String?

  importacao      Importacao    @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  movimentacao    Movimentacao? @relation(fields: [movimentacaoId], references: [id])

  @@index([importacaoId])
  @@index([contaId, fitId])
  @@map("importacao_linhas")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum PapelMembro {
  DONO
  ADMIN
  MEMBRO
  LEITOR
}

enum TipoConta {
  CORRENTE
  POUPANCA
  CAIXA
  CARTAO
  INVESTIMENTO
}

enum TipoMovimentacao {
  RECEITA
  DESPESA
}

enum StatusMovimentacao {
  PREVISTO
  PENDENTE
  PAGO
  CONCILIADO
  CANCELADO
}

enum FormaPagamento {
  PIX
  DEBITO
  CREDITO
  BOLETO
  TED
  DINHEIRO
  OUTRO
}

enum TipoContato {
  CLIENTE
  FORNECEDOR
  AMBOS
}

enum FrequenciaRegra {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}
